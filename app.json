{
  "expo": {
    "name": "PawWatch",
    "slug": "pawwatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawwatch.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pawwatch.app",
      "userInterfaceStyle": "light",
      "backgroundColor": "#FAF8F4",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0EA5E9"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "e16fa974-d754-4523-a2ce-b0f281ef62a0"
      }
    },
    "owner": "looneyt",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e16fa974-d754-4523-a2ce-b0f281ef62a0"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.pawwatch.app",
          "enableGooglePay": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
